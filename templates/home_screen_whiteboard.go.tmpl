<!DOCTYPE html>
<html lang="en">

	<head>
		<link rel="icon" type="image/png" href="/games/favicon.png">
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Whiteboard</title>
  <script type="text/javascript" >
  const url = "https://geof.geofpwhite.us"

  async function newgame(){
    const w = document.getElementById("imgWidth").value || 1000
    const h = document.getElementById("imgHeight").value || 500
    let x = await fetch(url+"/games/whiteboard/new_game?w="+w+"&h="+h)
    let code = await x.text()
    code = code.substring(1,7)
    window.location.href = url+ "/games/whiteboard/" + code

  }

  function joingame(){
    const id = document.getElementById("gameID").value.trim()
    if (id) window.location.href = url + "/games/whiteboard/" + id
  }
  </script>
  {{ template "styles" . }}
  <style>
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .row + .row { margin-top: 16px; }
  input[type="number"] { width: 90px; }
  label { font-size: 14px; color: var(--text-dim); }
  </style>
	</head>

	<body>
		{{ template "navbar" . }}
		<div class="page-center">
			<div class="card">
				<h2>Whiteboard</h2>
				<div class="row">
					<label>Width: <input type="number" id="imgWidth" value="1000" min="100" max="4000"></label>
					<label>Height: <input type="number" id="imgHeight" value="500" min="100" max="4000"></label>
					<button class="button" onclick="newgame()">New Game</button>
				</div>
				<div class="row">
					<input type="text" id="gameID" placeholder="Game ID">
					<button class="button" onclick="joingame()">Join Game</button>
				</div>
			</div>
		</div>
	</body>

</html>
