<!DOCTYPE html>
<html lang="en">

	<head>
		<link rel="icon" type="image/png" href="/games/favicon.png">
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Pong</title>

  <!-- The generated pong_pb.js (see pong/web) imports these as bare specifiers;
       there's no bundler in this project, so we resolve them straight off a CDN. -->
  <script type="importmap">
  {
    "imports": {
      "@bufbuild/protobuf/": "https://esm.sh/@bufbuild/protobuf@2.13.0/",
      "@bufbuild/protobuf": "https://esm.sh/@bufbuild/protobuf@2.13.0",
      "@connectrpc/connect": "https://esm.sh/@connectrpc/connect@2.1.2",
      "@connectrpc/connect-web": "https://esm.sh/@connectrpc/connect-web@2.1.2"
    }
  }
  </script>
  <script type="module" src="/games/pong_static/pong-client.js"></script>

  <style>
  body {
    font-family: sans-serif;
    background: #1a1a2e;
    color: #eee;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 20px;
    gap: 12px;
  }
  #pong-canvas {
    background-color: #111;
    border: 1px solid #ccc;
  }
  </style>
	</head>

	<body>
		{{ template "navbar" . }}
		<p id="pong-status">Connecting...</p>
		<canvas id="pong-canvas" width="600" height="400" data-game-id="{{ .GameID }}"></canvas>
		<p>Use Up/Down or W/S to move your paddle. Share this page's URL to invite an opponent.</p>
	</body>

</html>
