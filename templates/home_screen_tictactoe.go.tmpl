<!DOCTYPE html>
<html lang="en">

	<head>
		<link rel="icon" type="image/png" href="/games/favicon.png">
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Tic Tac Toe</title>
  <script type="text/javascript" >
  const url = "https://geof.geofpwhite.us"

  async function newgame(){
    let x = await fetch(url+"/games/tictactoe/new_game")
    let code = await x.json()
    console.log(code)

    window.location.href = url+ "/games/tictactoe/" + code.gameID

  }

  function joingame(){
    const id = document.getElementById("gameID").value.trim()
    if (id) window.location.href = url + "/games/tictactoe/" + id
  }
  </script>
  {{ template "styles" . }}
	</head>

	<body>
		{{ template "navbar" . }}
		<div class="page-center">
			<div class="card">
				<h2>Tic Tac Toe</h2>
				<button class="button" onclick="newgame()">New Game</button>
				<br><br>
				<input type="text" id="gameID" placeholder="Game ID">
				<button class="button" onclick="joingame()">Join Game</button>
			</div>
		</div>
	</body>

</html>
